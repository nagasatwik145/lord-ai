# --- AI (required for chat) ---
# Get a key at https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=

# --- Supabase (required for persistent chat history) ---
# Project settings -> API. The app's tables live in supabase/migrations.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Publishable (anon) key, used by the auth middleware and client.
SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- Optional ---
# Base URL for API calls when running as a native Capacitor app.
VITE_API_BASE_URL=
